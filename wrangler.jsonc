{
  "name": "feedee",
  "main": "worker/api.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "CALL_ROOMS", "class_name": "CallRoom" }]
  },
  "migrations": [{ "tag": "v1-call-rooms", "new_sqlite_classes": ["CallRoom"] }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feddie",
      "database_id": "3ac91169-e096-4f86-94d3-6bd069dc81b3"
    }
  ]
}
